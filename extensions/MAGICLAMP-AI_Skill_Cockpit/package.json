{
    "name": "magiclamp-ai-skill-cockpit",
    "displayName": "MAGICLAMP·AI Skill Cockpit",
    "description": "Universal Command Center for AI Skills, MCP Servers, and Extensions.",
    "version": "0.1.28",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/antigravity-ai/skill-cockpit"
    },
    "publisher": "antigravity",
    "engines": {
        "vscode": "^1.96.0"
    },
    "categories": [
        "AI",
        "Visualization",
        "Productivity"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onView:skillMockpitView",
        "onCommand:skillCockpit.open"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "skillCockpit.open",
                "title": "Open Skill Cockpit",
                "icon": "$(rocket)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "skill-cockpit-sidebar",
                    "title": "Skill Cockpit",
                    "icon": "$(hubot)"
                }
            ]
        },
        "views": {
            "skill-cockpit-sidebar": [
                {
                    "id": "skillMockpitView",
                    "name": "Resource Monitor",
                    "type": "webview"
                }
            ]
        },
        "configuration": {
            "title": "Skill Cockpit",
            "properties": {
                "skillCockpit.registries": {
                    "type": "array",
                    "default": [
                        "https://raw.githubusercontent.com/antigravity-ai/skill-cockpit/main/registry/discovery_manifest.json"
                    ],
                    "description": "List of URLs to discovery_manifest.json files."
                }
            }
        }
    },
    "scripts": {
        "release": "node ./scripts/release.js",
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.6",
        "@types/node": "20.x",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@types/vscode": "^1.96.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "css-loader": "^6.10.0",
        "eslint": "^8.56.0",
        "glob": "^10.3.10",
        "jsdom": "^27.4.0",
        "mocha": "^10.2.0",
        "style-loader": "^3.3.4",
        "ts-loader": "^9.5.1",
        "typescript": "^5.3.3",
        "webpack": "^5.90.0",
        "webpack-cli": "^5.1.4"
    },
    "dependencies": {
        "@vscode/codicons": "^0.0.35",
        "@vscode/webview-ui-toolkit": "^1.4.0",
        "clsx": "^2.1.0",
        "js-yaml": "^4.1.1",
        "jsonc-parser": "^3.2.1",
        "lucide-react": "^0.320.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "yaml-front-matter": "^4.1.1"
    },
    "keywords": [],
    "author": "",
    "type": "commonjs"
}