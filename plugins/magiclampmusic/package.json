{
  "name": "magiclampmusic",
  "displayName": "神灯音乐工作台",
  "description": "一体化 AI 音乐创作工作流",
  "version": "0.1.12",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/magiclampmusic"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "magiclampmusic",
          "title": "神灯音乐",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "magiclampmusic": [
        {
          "type": "webview",
          "id": "magiclampmusic.sidebar",
          "name": "快速启动",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "magiclampmusic.start",
        "title": "打开神灯音乐工作台",
        "category": "Magic Lamp",
        "icon": "$(music)"
      },
      {
        "command": "magiclampmusic.setApiKey",
        "title": "设置 Gemini API Key",
        "category": "Magic Lamp"
      },
      {
        "command": "magiclampmusic.setSunoKey",
        "title": "设置 Suno API Key",
        "category": "Magic Lamp"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "build:webview": "cd webview && npm install && npm run build"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/node": "20.2.5",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "ts-loader": "^9.4.3",
    "typescript": "^5.1.3",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.1"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.2",
    "uuid": "^9.0.0"
  }
}
